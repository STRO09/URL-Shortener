# Stage 1: Build using Java 8 and Maven
FROM maven:3.9.9-eclipse-temurin-8 AS builder

WORKDIR /app

COPY pom.xml .
COPY src ./src

RUN mvn clean package -DskipTests

# Stage 2: Lightweight Java 8 runtime
FROM eclipse-temurin:8-jre-jammy

WORKDIR /app

COPY --from=builder /app/target/URLShortener-0.0.1-SNAPSHOT.jar app.jar

# Container configuration
ENV JAVA_TOOL_OPTIONS="-Xms64m -Xmx256m -XX:MaxMetaspaceSize=128m -XX:+UseSerialGC"

EXPOSE 8080

ENTRYPOINT ["java", "-jar", "app.jar"]
